#ifndef DBG_SETTINGS
#define DBG_SETTINGS

/* Project settings in .dbg.toml. The shape matches cdbg's
 * target tables: one ["path"] table, points, and watches.
 * Appearance and keyboard bindings are not stored. The
 * file is written atomically with mode 0600. A malformed
 * file keeps its contents and disables saving. */

#include <fcntl>
#include <stdio>
#include <stat>
#include "args.scpp"

class SavedPoint {
public:
    SavedPoint();
    String *file;
    int line;
    int enabled;
    String *condition;
    int hitCount;
};

class SavedWatch {
public:
    SavedWatch();
    String *expression;
};

VECTOR(PointVec, SavedPoint *)
VECTOR(WatchVec, SavedWatch *)

class SavedTarget {
public:
    SavedTarget();
    String *path;
    int hasBreak;
    int breakAtStart;
    String *arguments;
    String *cwd;
    String *envText;
    PointVec *points;
    WatchVec *watches;
};

VECTOR(TargetVec, SavedTarget *)

class ProjectSettings {
public:
    ProjectSettings();
    void reset(void);
    int load(const char *path);
    int save(const char *path);
    SavedTarget *ensure(const char *path);
    SavedTarget *find(const char *path);
    int version;
    int breakAtStart;
    int width;
    int height;
    int maximized;
    int pane;
    int rightSplit;
    int midSplit;
    int bottomSplit;
    int showLocals;
    int showWatches;
    int showStack;
    int showBreaks;
    int showOutput;
    int showConsole;
    int showRuntime;
    int showThreads;
    int canSave;
    String *error;
    TargetVec *targets;
    void assign_top(const char *key, const char *value);
    void assign_target(
            SavedTarget *target,
            const char *key,
            const char *value);
    int read_string(
            const char *text,
            int *index,
            String *out);
    int read_value(const char *text, String *out);
    void add_point(SavedTarget *target, const char *text);
    void add_watch(SavedTarget *target, const char *text);
    void write_string(String *out, const char *text);
    void write_bool(String *out, const char *key, int value);
    void write_int(String *out, const char *key, int value);
};

SavedPoint::SavedPoint() {
    file = new String();
    line = 0;
    enabled = 1;
    condition = new String();
    hitCount = 0;
}

SavedWatch::SavedWatch() {
    expression = new String();
}

SavedTarget::SavedTarget() {
    path = new String();
    hasBreak = 0;
    breakAtStart = 1;
    arguments = new String();
    cwd = new String();
    envText = new String();
    points = new PointVec();
    watches = new WatchVec();
}

ProjectSettings::ProjectSettings() {
    error = new String();
    targets = new TargetVec();
    reset();
}

void ProjectSettings::reset(void) {
    version = 1;
    breakAtStart = 1;
    width = 1100;
    height = 760;
    maximized = 0;
    pane = 600;
    rightSplit = 420;
    midSplit = 220;
    bottomSplit = 400;
    showLocals = 1;
    showWatches = 1;
    showStack = 1;
    showBreaks = 1;
    showOutput = 1;
    showConsole = 1;
    showRuntime = 0;
    showThreads = 0;
    canSave = 1;
    string_set(error, "");
    targets = new TargetVec();
}

int ProjectSettings::read_string(
        const char *text,
        int *index,
        String *out) {
    int ch;

    string_set(out, "");
    if (text[*index] != '"')
        return 0;
    *index = *index + 1;
    while (text[*index] != 0 && text[*index] != '"') {
        ch = (unsigned char)text[*index];
        *index = *index + 1;
        if (ch == '\\') {
            ch = (unsigned char)text[*index];
            if (ch == 0)
                return 0;
            *index = *index + 1;
            if (ch == 'n')
                out->add('\n');
            else if (ch == 't')
                out->add('\t');
            else if (ch == 'r')
                out->add('\r');
            else
                out->add((char)ch);
        } else {
            out->add((char)ch);
        }
    }
    if (text[*index] != '"')
        return 0;
    *index = *index + 1;
    return 1;
}

int ProjectSettings::read_value(const char *text, String *out) {
    int index;

    index = 0;
    while (is_space(text[index]))
        index = index + 1;
    if (text[index] == '"')
        return read_string(text, &index, out);
    string_set(out, text + index);
    out->strip();
    return 1;
}

void ProjectSettings::assign_top(
        const char *key,
        const char *value) {
    int number;

    number = (int)strtol(value, nullptr, 10);
    if (same_text(key, "version"))
        version = number;
    else if (same_text(key, "break_at_start"))
        breakAtStart = same_text(value, "true");
    else if (same_text(key, "width"))
        width = bound_int(number, 640, 3840);
    else if (same_text(key, "height"))
        height = bound_int(number, 400, 2160);
    else if (same_text(key, "maximized"))
        maximized = same_text(value, "true");
    else if (same_text(key, "pane"))
        pane = number;
    else if (same_text(key, "right_split"))
        rightSplit = number;
    else if (same_text(key, "mid_split"))
        midSplit = number;
    else if (same_text(key, "bottom_split"))
        bottomSplit = number;
    else if (same_text(key, "show_locals"))
        showLocals = same_text(value, "true");
    else if (same_text(key, "show_watches"))
        showWatches = same_text(value, "true");
    else if (same_text(key, "show_stack"))
        showStack = same_text(value, "true");
    else if (same_text(key, "show_breaks"))
        showBreaks = same_text(value, "true");
    else if (same_text(key, "show_output"))
        showOutput = same_text(value, "true");
    else if (same_text(key, "show_console"))
        showConsole = same_text(value, "true");
    else if (same_text(key, "show_runtime"))
        showRuntime = same_text(value, "true");
    else if (same_text(key, "show_threads"))
        showThreads = same_text(value, "true");
    if (pane < 100)
        pane = 100;
    if (pane > width - 100)
        pane = width - 100;
}

void ProjectSettings::assign_target(
        SavedTarget *target,
        const char *key,
        const char *value) {
    if (target == nullptr)
        return;
    if (same_text(key, "break_at_start")) {
        target->hasBreak = 1;
        target->breakAtStart = same_text(value, "true");
    } else if (same_text(key, "arguments")) {
        string_set(target->arguments, value);
    } else if (same_text(key, "cwd")) {
        string_set(target->cwd, value);
    } else if (same_text(key, "env")) {
        string_set(target->envText, value);
    }
}

void ProjectSettings::add_point(
        SavedTarget *target,
        const char *text) {
    SavedPoint *point;
    String *value;
    int index;

    if (target == nullptr)
        return;
    if (target->points->size() >= 256) {
        string_set(error, "at most 256 breakpoints");
        return;
    }
    point = new SavedPoint();
    value = new String();
    index = 0;
    while (text[index] != 0
            && starts_text(text + index, "file") == 0)
        index = index + 1;
    while (text[index] != 0 && text[index] != '"')
        index = index + 1;
    if (read_string(text, &index, value) == 0) {
        canSave = 0;
        string_set(error, "malformed breakpoint");
        return;
    }
    string_set(point->file, value->c_str());
    while (text[index] != 0
            && starts_text(text + index, "line") == 0)
        index = index + 1;
    while (text[index] != 0 && text[index] != '=')
        index = index + 1;
    if (text[index] == '=')
        index = index + 1;
    point->line = (int)strtol(text + index, nullptr, 10);
    point->enabled = 1;
    index = 0;
    while (text[index] != 0
            && starts_text(text + index, "enabled") == 0)
        index = index + 1;
    if (starts_text(text + index, "enabled")) {
        while (text[index] != 0 && text[index] != '=')
            index = index + 1;
        if (text[index] == '=')
            index = index + 1;
        while (is_space(text[index]))
            index = index + 1;
        point->enabled = starts_text(text + index, "true");
    }
    index = 0;
    while (text[index] != 0
            && starts_text(text + index, "condition") == 0)
        index = index + 1;
    if (starts_text(text + index, "condition")) {
        while (text[index] != 0 && text[index] != '"')
            index = index + 1;
        if (text[index] == '"')
            read_string(text, &index, point->condition);
    }
    index = 0;
    while (text[index] != 0
            && starts_text(text + index, "hit_count") == 0)
        index = index + 1;
    if (starts_text(text + index, "hit_count")) {
        while (text[index] != 0 && text[index] != '=')
            index = index + 1;
        if (text[index] == '=')
            index = index + 1;
        point->hitCount = (int)strtol(text + index, nullptr, 10);
    }
    target->points->add(point);
}

void ProjectSettings::add_watch(
        SavedTarget *target,
        const char *text) {
    SavedWatch *watch;
    int index;

    if (target == nullptr)
        return;
    watch = new SavedWatch();
    index = 0;
    while (text[index] != 0 && text[index] != '"')
        index = index + 1;
    if (read_string(text, &index, watch->expression) == 0) {
        canSave = 0;
        string_set(error, "malformed watch");
        return;
    }
    target->watches->add(watch);
}

int ProjectSettings::load(const char *path) {
    File *file;
    char buf[1024];
    String *body;
    String *line;
    String *key;
    String *value;
    unsigned long got;
    int index;
    int start;
    int mode;
    int eq;
    SavedTarget *current;
    struct stat info;

    reset();
    if (path == nullptr || path[0] == 0)
        return 1;
    if (stat(path, &info) != 0)
        return 1;
    if (info.st_size > 262144) {
        canSave = 0;
        string_set(error, "settings file exceeds 256 KiB");
        return 0;
    }
    file = fopen(path, "r");
    if (file == nullptr) {
        canSave = 0;
        string_set(error, "settings file is unreadable");
        return 0;
    }
    body = new String();
    got = fread(
            (void *)buf,
            (unsigned long)1,
            (unsigned long)1024,
            file);
    while (got > 0) {
        string_add_bytes(body, buf, (long)got);
        got = fread(
                (void *)buf,
                (unsigned long)1,
                (unsigned long)1024,
                file);
    }
    fclose(file);
    current = nullptr;
    mode = 0;
    index = 0;
    while (index <= (int)body->size()) {
        start = index;
        while (index < (int)body->size()
                && body->at(index) != '\n')
            index = index + 1;
        line = new String();
        string_add_bytes(
                line,
                body->c_str() + start,
                index - start);
        line->strip();
        if (line->size() > 0 && line->at(0) != '#') {
            if (line->at(0) == ']' ) {
                mode = 1;
            } else if (starts_text(line->c_str(), "points")) {
                mode = 2;
            } else if (starts_text(line->c_str(), "watches")) {
                mode = 3;
            } else if (line->at(0) == '['
                    && line->size() > 2
                    && line->at(1) == '"') {
                key = new String();
                eq = 1;
                if (read_string(line->c_str(), &eq, key) == 0) {
                    reset();
                    canSave = 0;
                    string_set(error, "malformed target header");
                    return 0;
                }
                current = ensure(key->c_str());
                mode = 1;
            } else if ((mode == 2 || mode == 3)
                    && line->at(0) == '{') {
                if (mode == 2)
                    add_point(current, line->c_str());
                else
                    add_watch(current, line->c_str());
            } else {
                eq = (int)line->find('=');
                if (eq > 0) {
                    key = new String();
                    string_add_bytes(key, line->c_str(), eq);
                    key->strip();
                    value = new String();
                    if (read_value(
                            line->c_str() + eq + 1,
                            value) == 0) {
                        reset();
                        canSave = 0;
                        string_set(
                                error,
                                "malformed settings value");
                        return 0;
                    }
                    if (mode == 0 || current == nullptr)
                        assign_top(
                                key->c_str(),
                                value->c_str());
                    else
                        assign_target(
                                current,
                                key->c_str(),
                                value->c_str());
                }
            }
        }
        if (index >= (int)body->size())
            break;
        index = index + 1;
    }
    return 1;
}

SavedTarget *ProjectSettings::find(const char *path) {
    long index;

    index = 0;
    while (index < targets->size()) {
        if (same_text(targets->at(index)->path->c_str(), path))
            return targets->at(index);
        index = index + 1;
    }
    return nullptr;
}

SavedTarget *ProjectSettings::ensure(const char *path) {
    SavedTarget *target;

    target = find(path);
    if (target != nullptr)
        return target;
    target = new SavedTarget();
    string_set(target->path, path);
    targets->add(target);
    return target;
}

void ProjectSettings::write_string(String *out, const char *text) {
    int index;
    int ch;

    out->append("\"");
    index = 0;
    if (text == nullptr)
        text = "";
    while (text[index] != 0) {
        ch = (unsigned char)text[index];
        if (ch == '\\' || ch == '"') {
            out->append("\\");
            out->add((char)ch);
        } else if (ch == '\n') {
            out->append("\\n");
        } else if (ch == '\t') {
            out->append("\\t");
        } else {
            out->add((char)ch);
        }
        index = index + 1;
    }
    out->append("\"");
}

void ProjectSettings::write_bool(
        String *out,
        const char *key,
        int value) {
    out->append(key);
    if (value)
        out->append(" = true\n");
    else
        out->append(" = false\n");
}

void ProjectSettings::write_int(
        String *out,
        const char *key,
        int value) {
    out->append(key);
    out->append(" = ");
    out->append(format("{}", value));
    out->append("\n");
}

int ProjectSettings::save(const char *path) {
    String *body;
    String *temp;
    SavedTarget *target;
    SavedPoint *point;
    SavedWatch *watch;
    long index;
    long cursor;
    int fd;
    long wrote;
    long size;

    if (canSave == 0) {
        string_set(error, "saving is disabled");
        return 0;
    }
    body = new String();
    write_int(body, "version", 1);
    write_bool(body, "break_at_start", breakAtStart);
    write_int(body, "width", width);
    write_int(body, "height", height);
    write_bool(body, "maximized", maximized);
    write_int(body, "pane", pane);
    write_int(body, "right_split", rightSplit);
    write_int(body, "mid_split", midSplit);
    write_int(body, "bottom_split", bottomSplit);
    write_bool(body, "show_locals", showLocals);
    write_bool(body, "show_watches", showWatches);
    write_bool(body, "show_stack", showStack);
    write_bool(body, "show_breaks", showBreaks);
    write_bool(body, "show_output", showOutput);
    write_bool(body, "show_console", showConsole);
    write_bool(body, "show_runtime", showRuntime);
    write_bool(body, "show_threads", showThreads);
    body->append("\n");
    index = 0;
    while (index < targets->size()) {
        target = targets->at(index);
        body->append("[");
        write_string(body, target->path->c_str());
        body->append("]\n");
        if (target->hasBreak)
            write_bool(
                    body,
                    "break_at_start",
                    target->breakAtStart);
        body->append("arguments = ");
        write_string(body, target->arguments->c_str());
        body->append("\n");
        body->append("cwd = ");
        write_string(body, target->cwd->c_str());
        body->append("\n");
        body->append("env = ");
        write_string(body, target->envText->c_str());
        body->append("\n");
        body->append("points = [\n");
        cursor = 0;
        while (cursor < target->points->size()) {
            point = target->points->at(cursor);
            body->append("{ file = ");
            write_string(body, point->file->c_str());
            body->append(", line = ");
            body->append(format("{}", point->line));
            body->append(", enabled = ");
            if (point->enabled)
                body->append("true");
            else
                body->append("false");
            body->append(", condition = ");
            write_string(body, point->condition->c_str());
            body->append(", hit_count = ");
            body->append(format("{}", point->hitCount));
            body->append(" },\n");
            cursor = cursor + 1;
        }
        body->append("]\n");
        body->append("watches = [\n");
        cursor = 0;
        while (cursor < target->watches->size()) {
            watch = target->watches->at(cursor);
            body->append("{ expression = ");
            write_string(body, watch->expression->c_str());
            body->append(" },\n");
            cursor = cursor + 1;
        }
        body->append("]\n");
        index = index + 1;
    }
    temp = new String();
    temp->append(path);
    temp->append(".tmp");
    fd = open(temp->c_str(), O_WRONLY | O_CREAT | O_TRUNC, 384);
    if (fd < 0) {
        string_set(error, "Settings not saved to ");
        error->append(path);
        return 0;
    }
    size = body->size();
    wrote = write(
            fd,
            (const void *)body->c_str(),
            (unsigned long)size);
    close(fd);
    if (wrote != size) {
        unlink(temp->c_str());
        string_set(error, "Settings not saved to ");
        error->append(path);
        return 0;
    }
    if (rename(temp->c_str(), path) != 0) {
        unlink(temp->c_str());
        string_set(error, "Settings not saved to ");
        error->append(path);
        return 0;
    }
    string_set(error, "");
    return 1;
}

#endif
