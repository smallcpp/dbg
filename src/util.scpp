#include "util.shpp"

int text_length(const char *text) {
    int count;

    if (text == nullptr)
        return 0;
    count = 0;
    while (text[count] != 0)
        count = count + 1;
    return count;
}

int same_text(const char *left, const char *right) {
    int index;

    if (left == nullptr || right == nullptr)
        return 0;
    index = 0;
    while (left[index] != 0 && left[index] == right[index])
        index = index + 1;
    if (left[index] == right[index])
        return 1;
    return 0;
}

int starts_text(const char *text, const char *prefix) {
    int index;

    if (text == nullptr || prefix == nullptr)
        return 0;
    index = 0;
    while (prefix[index] != 0) {
        if (text[index] != prefix[index])
            return 0;
        index = index + 1;
    }
    return 1;
}

int ends_text(const char *text, const char *suffix) {
    int textCount;
    int suffixCount;
    int index;

    textCount = text_length(text);
    suffixCount = text_length(suffix);
    if (suffixCount > textCount)
        return 0;
    index = 0;
    while (index < suffixCount) {
        if (text[textCount - suffixCount + index]
                != suffix[index])
            return 0;
        index = index + 1;
    }
    return 1;
}

int is_digit(int value) {
    if (value >= '0' && value <= '9')
        return 1;
    return 0;
}

int is_space(int value) {
    if (value == ' ' || value == '\t'
            || value == '\n' || value == '\r')
        return 1;
    return 0;
}

char *text_copy(const char *text) {
    char *copy;
    int count;
    int index;

    count = text_length(text);
    copy = (char *)malloc((unsigned long)count + 1);
    if (copy == nullptr)
        throw *new Exception("memory");
    index = 0;
    while (index < count) {
        copy[index] = text[index];
        index = index + 1;
    }
    copy[count] = 0;
    return copy;
}

void string_set(String *text, const char *value) {
    if (text == nullptr)
        throw *new Exception("string");
    if (value == nullptr)
        throw *new Exception("string");
    text->truncate(0, text->size());
    text->append(value);
}

void string_add_bytes(
        String *text,
        const char *bytes,
        long count) {
    long index;

    index = 0;
    while (index < count) {
        if (bytes[index] == 0)
            text->append("\\0");
        else
            text->add(bytes[index]);
        index = index + 1;
    }
}

String *string_from(const char *value) {
    String *text;

    text = new String();
    if (value != nullptr)
        text->append(value);
    return text;
}

int bound_int(int value, int low, int high) {
    if (value < low)
        return low;
    if (value > high)
        return high;
    return value;
}

String *canonical_path(const char *path) {
    char buf[4096];
    char *resolved;
    String *text;

    if (path == nullptr || path[0] == 0)
        throw *new Exception("path");
    resolved = realpath(path, buf);
    text = new String();
    if (resolved == nullptr)
        text->append(path);
    else
        text->append(resolved);
    return text;
}

int require_test(int cond, const char *reason) {
    if (cond != 0)
        return 1;
    print("fail {:s}\n", reason);
    return 0;
}
