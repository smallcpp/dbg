#include "session.shpp"

DebugBreak::DebugBreak() {
    number = new String();
    file = new String();
    fullname = new String();
    func = new String();
    addr = new String();
    condition = new String();
    line = 0;
    enabled = 1;
    pending = 0;
    hits = 0;
}

DebugFrame::DebugFrame() {
    func = new String();
    file = new String();
    fullname = new String();
    addr = new String();
    level = 0;
    line = 0;
}

DebugVar::DebugVar() {
    name = new String();
    value = new String();
    argument = 0;
}

DebugWatch::DebugWatch() {
    expression = new String();
    value = new String();
    error = new String();
}

DebugThread::DebugThread() {
    id = new String();
    name = new String();
    target = new String();
}

HitSnap::HitSnap() {
    number = new String();
    hits = 0;
    enabled = 1;
}

DebugJob::DebugJob() {
    text = new String();
    purpose = PURPOSE_NONE;
    rank = RANK_LOW;
    kind = JOB_QUERY;
    follow = FOLLOW_NONE;
    soft = 0;
    extra = 0;
}

DebugSession::DebugSession() {
    state = DEBUG_EMPTY;
    breakAtStart = 1;
    selectedFrame = 0;
    stopLine = 0;
    exitCode = 0;
    haveExit = 0;
    missedCount = 0;
    sawPrompt = 0;
    status = new String();
    console = new String();
    program = new String();
    errorText = new String();
    executable = new String();
    stopFile = new String();
    stopFull = new String();
    stopFunc = new String();
    stopReason = new String();
    stopAddr = new String();
    stopBkpt = new String();
    lastNumber = new String();
    directory = new String();
    breaks = new BreakVec();
    frames = new FrameVec();
    locals = new VarVec();
    watches = new WatchList();
    threads = new ThreadVec();
    arguments = new ArgumentList();
    environment = new EnvironmentList();
    parser = new MiParser();
    lastValue = new MiValue();
    lastMsg = new String();
    pendingOut = new String();
    pendingErr = new String();
    prevFile = new String();
    prevFunc = new String();
    prevAddr = new String();
    startBreak = new String();
    ownedDir = new String();
    ownedExe = new String();
    snaps = new SnapVec();
    waitingToken = 0;
    waitingPurpose = PURPOSE_NONE;
    resultSerial = 0;
    stopSerial = 0;
    exitSerial = 0;
    lastOk = 0;
    prevLine = 0;
    havePrev = 0;
    runStops = 0;
    runExits = 0;
    toGdb = -1;
    fromGdb = -1;
    fromErr = -1;
    gdbPid = 0;
    inferiorPid = 0;
    gdbDead = 0;
    yield = 0;
    stepping = FOLLOW_NONE;
    hops = 0;
    hopLine = 0;
    recordCommands = 0;
    seenResult = 0;
    seenStop = 0;
    seenExit = 0;
    sawExec = 0;
    hopFile = new String();
    hopFunc = new String();
    fillLog = new String();
    commandTrace = new String();
    commandError = new String();
    reset_driver();
    string_set(status, "No target");
}

DebugSession::~DebugSession() {
    close_gdb();
}

long DebugSession::now_ms(void) {
    struct timespec clock;

    clock.tv_sec = 0;
    clock.tv_nsec = 0;
    clock_gettime(CLOCK_MONOTONIC, &clock);
    return clock.tv_sec * 1000 + clock.tv_nsec / 1000000;
}

void DebugSession::fail(const char *code, const char *text) {
    const char *msg;

    if (text == nullptr)
        text = "failed";
    msg = format("dbg: error[{:s}]: {:s}", code, text);
    string_set(errorText, msg);
    append_console(errorText->c_str());
    append_console("\n");
    throw *new Exception(errorText->c_str());
}

void DebugSession::append_console(const char *text) {
    if (text == nullptr)
        return;
    console->append(text);
    if (console->size() > 65536)
        console->truncate(0, console->size() - 65536);
}

void DebugSession::append_program(const char *text) {
    if (text == nullptr)
        return;
    program->append(text);
    if (program->size() > 65536)
        program->truncate(0, program->size() - 65536);
}

void DebugSession::write_all(const char *text) {
    long size;
    long wrote;
    long at;

    if (toGdb < 0)
        fail("DBG3003", "GDB input is closed");
    size = text_length(text);
    at = 0;
    while (at < size) {
        wrote = write(
                toGdb,
                (const void *)(text + at),
                (unsigned long)(size - at));
        if (wrote < 0) {
            if (errno == EINTR)
                continue;
            fail("DBG3003", "GDB command write failed");
        }
        at = at + wrote;
    }
}

void DebugSession::issue(const char *command, int purpose) {
    String *line;

    waitingToken = waitingToken + 1;
    waitingPurpose = purpose;
    lastOk = 0;
    if (recordCommands != 0) {
        commandTrace->append(command);
        commandTrace->append("\n");
    }
    line = new String();
    line->append(format("{}", waitingToken));
    line->append(command);
    line->append("\n");
    write_all(line->c_str());
}

void DebugSession::accept_line(const char *line) {
    int kind;
    int token;
    const char *msg;
    MiValue *frame;

    if (line == nullptr || line[0] == 0)
        return;
    if (starts_text(line, "(gdb)")) {
        sawPrompt = 1;
        return;
    }
    kind = (unsigned char)line[0];
    if (is_digit(kind) == 0 && kind != '^' && kind != '*'
            && kind != '=' && kind != '+' && kind != '~'
            && kind != '@' && kind != '&') {
        append_program(line);
        append_program("\n");
        return;
    }
    if (parser->parse(line) == 0) {
        append_console("dbg: error[DBG3004]: malformed record\n");
        return;
    }
    kind = (unsigned char)parser->kind->at(0);
    if (kind == '~' || kind == '&') {
        append_console(parser->data->text());
        return;
    }
    if (kind == '@') {
        append_program(parser->data->text());
        return;
    }
    if (kind == '*') {
        if (same_text(parser->result->c_str(), "stopped")) {
            string_set(
                    stopReason,
                    parser->data->field("reason")->text());
            string_set(
                    stopBkpt,
                    parser->data->field("bkptno")->text());
            frame = parser->data->field("frame");
            string_set(stopFile, frame->field("file")->text());
            string_set(
                    stopFull,
                    frame->field("fullname")->text());
            string_set(stopFunc, frame->field("func")->text());
            string_set(stopAddr, frame->field("addr")->text());
            stopLine = (int)strtol(
                    frame->field("line")->text(),
                    nullptr,
                    10);
            if (starts_text(stopReason->c_str(), "exited")) {
                state = DEBUG_EXITED;
                haveExit = 1;
                if (same_text(
                        stopReason->c_str(),
                        "exited-normally"))
                    exitCode = 0;
                else
                    exitCode = (int)strtol(
                            parser->data->field(
                                "exit-code")->text(),
                            nullptr,
                            8);
                exitSerial = exitSerial + 1;
            } else {
                state = DEBUG_STOPPED;
            }
            stopSerial = stopSerial + 1;
        } else if (same_text(parser->result->c_str(), "running")) {
            state = DEBUG_RUNNING;
        }
        return;
    }
    if (kind == '=') {
        if (same_text(
                parser->result->c_str(),
                "thread-group-started")) {
            inferiorPid = (int)strtol(
                    parser->data->field("pid")->text(),
                    nullptr,
                    10);
        } else if (same_text(
                parser->result->c_str(),
                "thread-group-exited")) {
            state = DEBUG_EXITED;
            haveExit = 1;
            if (parser->data->field("exit-code")->text()[0]
                    != 0)
                exitCode = (int)strtol(
                        parser->data->field(
                            "exit-code")->text(),
                        nullptr,
                        8);
            exitSerial = exitSerial + 1;
            inferiorPid = 0;
        }
        return;
    }
    if (kind != '^')
        return;
    token = 0;
    if (parser->token->size() > 0)
        token = (int)strtol(parser->token->c_str(), nullptr, 10);
    if (token != waitingToken || waitingToken == 0)
        return;
    lastValue = parser->data;
    if (same_text(parser->result->c_str(), "error")) {
        lastOk = 0;
        msg = parser->data->field("msg")->text();
        string_set(lastMsg, msg);
        string_set(errorText, msg);
        append_console(msg);
        append_console("\n");
    } else {
        lastOk = 1;
        string_set(lastMsg, "");
        if (same_text(parser->result->c_str(), "running"))
            state = DEBUG_RUNNING;
    }
    resultSerial = resultSerial + 1;
}

void DebugSession::drain(String *pending, int asError) {
    long at;
    String *line;

    at = pending->find('\n');
    while (at >= 0) {
        line = new String();
        string_add_bytes(line, pending->c_str(), at);
        if (line->size() > 0
                && line->at(line->size() - 1) == '\r')
            line->truncate(line->size() - 1, line->size());
        pending->truncate(0, at + 1);
        if (asError)
            append_console(line->c_str());
        else
            accept_line(line->c_str());
        if (asError)
            append_console("\n");
        at = pending->find('\n');
    }
    if (pending->size() > 1048576)
        fail("DBG3004", "GDB record exceeds 1 MiB");
}

void DebugSession::accept_bytes(
        const char *bytes,
        long count,
        int asError) {
    if (asError) {
        string_add_bytes(pendingErr, bytes, count);
        drain(pendingErr, 1);
    } else {
        string_add_bytes(pendingOut, bytes, count);
        drain(pendingOut, 0);
    }
}

void DebugSession::pump(int timeoutMs) {
    fd_set reads;
    struct timeval limit;
    char buf[4096];
    long count;
    int ready;
    int maxFd;

    if (fromGdb < 0)
        fail("DBG3002", "GDB is not running");
    FD_ZERO(&reads);
    FD_SET(fromGdb, &reads);
    maxFd = fromGdb;
    if (fromErr >= 0) {
        FD_SET(fromErr, &reads);
        if (fromErr > maxFd)
            maxFd = fromErr;
    }
    limit.tv_sec = timeoutMs / 1000;
    limit.tv_usec = (timeoutMs % 1000) * 1000;
    ready = select(maxFd + 1, &reads, nullptr, nullptr, &limit);
    if (ready < 0) {
        if (errno == EINTR)
            return;
        fail("DBG3003", "GDB read failed");
    }
    if (ready == 0)
        return;
    if (FD_ISSET(fromGdb, &reads) != 0) {
        count = read(fromGdb, (void *)buf, 4096);
        if (count > 0)
            accept_bytes(buf, count, 0);
        else if (count == 0)
            gdbDead = 1;
    }
    if (fromErr >= 0 && FD_ISSET(fromErr, &reads) != 0) {
        count = read(fromErr, (void *)buf, 4096);
        if (count > 0)
            accept_bytes(buf, count, 1);
    }
}

void DebugSession::wait_result(int timeoutMs) {
    int serial;
    long start;

    serial = resultSerial;
    start = now_ms();
    while (resultSerial == serial) {
        if (gdbDead != 0)
            fail("DBG3002", "GDB exited");
        if (now_ms() - start > timeoutMs)
            fail("DBG3002", "GDB did not answer");
        pump(200);
    }
    if (lastOk == 0)
        fail("DBG3002", lastMsg->c_str());
}

void DebugSession::transact(const char *command, int purpose) {
    issue(command, purpose);
    wait_result(8000);
}

int DebugSession::try_transact(
        const char *command,
        int purpose) {
    try {
        transact(command, purpose);
        return 1;
    } catch (Exception error) {
        (void)error;
        return 0;
    }
}

void DebugSession::wait_stop(int timeoutMs, int stops, int exits) {
    long start;

    start = now_ms();
    while (stopSerial == stops && exitSerial == exits) {
        if (gdbDead != 0)
            fail("DBG3002", "GDB exited");
        if (now_ms() - start > timeoutMs)
            fail("DBG3002", "GDB did not stop");
        pump(200);
    }
}

void DebugSession::open_gdb(const char *path) {
    int input[2];
    int output[2];
    int errors[2];
    int spawned;
    pid_t pid;
    posix_spawn_file_actions_t actions;
    posix_spawnattr_t attr;
    char *arg0;
    char *arg1;
    char *arg2;
    char *arg3;
    char *arg4;
    char *arg5;
    char *argv[7];
    long start;

    if (path == nullptr || path[0] == 0)
        path = "gdb";
    signal(SIGPIPE, SIG_IGN);
    if (pipe(input) != 0 || pipe(output) != 0 || pipe(errors) != 0)
        fail("DBG3003", "could not allocate GDB pipes");
    arg0 = text_copy(path);
    arg1 = text_copy("--nx");
    arg2 = text_copy("--quiet");
    arg3 = text_copy("--interpreter=mi2");
    arg4 = text_copy("-iex");
    arg5 = text_copy("set auto-load off");
    argv[0] = arg0;
    argv[1] = arg1;
    argv[2] = arg2;
    argv[3] = arg3;
    argv[4] = arg4;
    argv[5] = arg5;
    argv[6] = nullptr;
    posix_spawn_file_actions_init(&actions);
    posix_spawn_file_actions_adddup2(&actions, input[0], 0);
    posix_spawn_file_actions_adddup2(&actions, output[1], 1);
    posix_spawn_file_actions_adddup2(&actions, errors[1], 2);
    posix_spawn_file_actions_addclose(&actions, input[0]);
    posix_spawn_file_actions_addclose(&actions, input[1]);
    posix_spawn_file_actions_addclose(&actions, output[0]);
    posix_spawn_file_actions_addclose(&actions, output[1]);
    posix_spawn_file_actions_addclose(&actions, errors[0]);
    posix_spawn_file_actions_addclose(&actions, errors[1]);
    posix_spawnattr_init(&attr);
    posix_spawnattr_setflags(&attr, POSIX_SPAWN_SETPGROUP);
    posix_spawnattr_setpgroup(&attr, 0);
    pid = 0;
    spawned = posix_spawnp(
            &pid,
            path,
            &actions,
            &attr,
            argv,
            environ);
    posix_spawn_file_actions_destroy(&actions);
    posix_spawnattr_destroy(&attr);
    close(input[0]);
    close(output[1]);
    close(errors[1]);
    free((void *)arg0);
    free((void *)arg1);
    free((void *)arg2);
    free((void *)arg3);
    free((void *)arg4);
    free((void *)arg5);
    if (spawned != 0) {
        close(input[1]);
        close(output[0]);
        close(errors[0]);
        fail("DBG3002", "could not start GDB");
    }
    toGdb = input[1];
    fromGdb = output[0];
    fromErr = errors[0];
    gdbPid = pid;
    start = now_ms();
    while (sawPrompt == 0) {
        if (now_ms() - start > 3000)
            fail("DBG3002", "GDB did not send a prompt");
        pump(200);
    }
    transact("-gdb-set pagination off", PURPOSE_SETUP);
    transact("-gdb-set mi-async on", PURPOSE_SETUP);
    transact("-gdb-set confirm off", PURPOSE_SETUP);
    transact("-gdb-set host-charset UTF-8", PURPOSE_SETUP);
    transact("-gdb-set may-call-functions off", PURPOSE_SETUP);
    transact("-gdb-set print elements 8", PURPOSE_SETUP);
    transact("-gdb-set print max-depth 2", PURPOSE_SETUP);
}

void DebugSession::close_gdb(void) {
    struct timespec pause;
    int status;
    int got;
    int spins;

    reset_driver();
    if (toGdb >= 0) {
        write(toGdb, (const void *)"-gdb-exit\n", 10);
        close(toGdb);
        toGdb = -1;
    }
    if (fromGdb >= 0) {
        close(fromGdb);
        fromGdb = -1;
    }
    if (fromErr >= 0) {
        close(fromErr);
        fromErr = -1;
    }
    if (gdbPid > 0) {
        spins = 0;
        got = 0;
        status = 0;
        pause.tv_sec = 0;
        pause.tv_nsec = 100000000;
        while (spins < 10) {
            got = waitpid(gdbPid, &status, WNOHANG);
            if (got != 0)
                break;
            nanosleep(&pause, nullptr);
            spins = spins + 1;
        }
        if (got == 0) {
            kill(gdbPid, SIGKILL);
            kill(-gdbPid, SIGKILL);
            if (inferiorPid > 0)
                kill(inferiorPid, SIGKILL);
            waitpid(gdbPid, &status, 0);
        }
        gdbPid = 0;
    }
    if (ownedExe->size() > 0)
        unlink(ownedExe->c_str());
    if (ownedDir->size() > 0)
        rmdir(ownedDir->c_str());
    string_set(ownedExe, "");
    string_set(ownedDir, "");
    inferiorPid = 0;
}

void DebugSession::note_temp(const char *dir, const char *exe) {
    if (dir != nullptr)
        string_set(ownedDir, dir);
    if (exe != nullptr)
        string_set(ownedExe, exe);
}

void DebugSession::load_program(const char *path) {
    String *command;
    String *quoted;

    if (path == nullptr || path[0] == 0)
        fail("DBG1001", "missing executable");
    command = new String();
    quoted = parser->quote(path);
    command->append("-file-exec-and-symbols ");
    command->append(quoted->c_str());
    transact(command->c_str(), PURPOSE_LOAD);
    string_set(executable, path);
    state = DEBUG_LOADED;
    havePrev = 0;
    send_runtime();
    update_status();
}

void DebugSession::send_runtime(void) {
    String *command;
    String *quoted;
    long index;

    if (state == DEBUG_EMPTY)
        return;
    if (directory->size() > 0) {
        command = new String();
        quoted = parser->quote(directory->c_str());
        command->append("-environment-cd ");
        command->append(quoted->c_str());
        transact(command->c_str(), PURPOSE_OTHER);
    }
    index = 0;
    while (index < environment->pairs->size()) {
        command = new String();
        command->append("-gdb-set environment ");
        command->append(
                environment->pairs->at(index)->name->c_str());
        command->append(" ");
        quoted = parser->quote(
                environment->pairs->at(index)->value->c_str());
        command->append(quoted->c_str());
        transact(command->c_str(), PURPOSE_OTHER);
        index = index + 1;
    }
    command = new String();
    command->append("-exec-arguments");
    index = 0;
    while (index < arguments->values->size()) {
        command->append(" ");
        quoted = parser->quote(
                arguments->values->at(index)->c_str());
        command->append(quoted->c_str());
        index = index + 1;
    }
    transact(command->c_str(), PURPOSE_OTHER);
}

void DebugSession::set_arguments(const char *text) {
    if (arguments->parse(text) == 0)
        fail("DBG1000", arguments->error->c_str());
    if (state != DEBUG_EMPTY)
        send_runtime();
}

void DebugSession::set_directory(const char *path) {
    struct stat info;

    if (path == nullptr)
        path = "";
    if (path[0] != 0) {
        if (stat(path, &info) != 0 || S_ISDIR(info.st_mode) == 0)
            fail("DBG1000", "working directory does not exist");
    }
    string_set(directory, path);
    if (state != DEBUG_EMPTY && path[0] != 0)
        send_runtime();
}

void DebugSession::set_environment(const char *text) {
    if (environment->parse(text) == 0)
        fail("DBG1000", environment->error->c_str());
    if (state != DEBUG_EMPTY)
        send_runtime();
}

void DebugSession::insert_breakpoint(const char *file, int line) {
    String *command;
    String *where;
    String *quoted;

    if (state == DEBUG_EMPTY)
        fail("DBG1000", "no target is loaded");
    if (file == nullptr || file[0] == 0 || line <= 0)
        fail("DBG1000", "breakpoint needs a file and line");
    where = new String();
    where->append(file);
    where->append(":");
    where->append(format("{}", line));
    quoted = parser->quote(where->c_str());
    command = new String();
    command->append("-break-insert ");
    command->append(quoted->c_str());
    if (defer_job(
            command->c_str(),
            PURPOSE_BREAK_CMD,
            0) != 0)
        return;
    transact(command->c_str(), PURPOSE_BREAKS);
    string_set(
            lastNumber,
            lastValue->field("bkpt")->field("number")->text());
    refresh_breaks();
}

void DebugSession::delete_breakpoint(const char *number) {
    String *command;

    command = new String();
    command->append("-break-delete ");
    command->append(number);
    if (defer_job(
            command->c_str(),
            PURPOSE_BREAK_CMD,
            0) != 0)
        return;
    transact(command->c_str(), PURPOSE_BREAKS);
    refresh_breaks();
}

void DebugSession::enable_breakpoint(
        const char *number,
        int enabled) {
    String *command;

    command = new String();
    if (enabled)
        command->append("-break-enable ");
    else
        command->append("-break-disable ");
    command->append(number);
    if (defer_job(
            command->c_str(),
            PURPOSE_BREAK_CMD,
            0) != 0)
        return;
    transact(command->c_str(), PURPOSE_BREAKS);
    refresh_breaks();
}

void DebugSession::set_condition(
        const char *number,
        const char *expr) {
    String *command;
    String *quoted;

    command = new String();
    command->append("-break-condition ");
    command->append(number);
    if (expr != nullptr && expr[0] != 0) {
        command->append(" ");
        quoted = parser->quote(expr);
        command->append(quoted->c_str());
    }
    if (defer_job(
            command->c_str(),
            PURPOSE_BREAK_CMD,
            0) != 0)
        return;
    transact(command->c_str(), PURPOSE_BREAKS);
    refresh_breaks();
}

void DebugSession::set_ignore(const char *number, int count) {
    String *command;

    if (count < 0)
        count = 0;
    command = new String();
    command->append("-break-after ");
    command->append(number);
    command->append(" ");
    command->append(format("{}", count));
    if (defer_job(
            command->c_str(),
            PURPOSE_BREAK_CMD,
            0) != 0)
        return;
    transact(command->c_str(), PURPOSE_BREAKS);
    refresh_breaks();
}

void DebugSession::apply_frames(void) {
    MiValue *stack;
    MiValue *frame;
    DebugFrame *item;
    long index;

    frames = new FrameVec();
    stack = lastValue->field("stack");
    index = 0;
    while (index < stack->count() && index < 31) {
        frame = stack->at(index);
        item = new DebugFrame();
        item->level = (int)strtol(
                frame->field("level")->text(),
                nullptr,
                10);
        item->line = (int)strtol(
                frame->field("line")->text(),
                nullptr,
                10);
        string_set(item->func, frame->field("func")->text());
        string_set(item->file, frame->field("file")->text());
        string_set(
                item->fullname,
                frame->field("fullname")->text());
        string_set(item->addr, frame->field("addr")->text());
        frames->add(item);
        index = index + 1;
    }
}

void DebugSession::apply_locals(void) {
    MiValue *vars;
    MiValue *item;
    DebugVar *local;
    long index;

    locals = new VarVec();
    vars = lastValue->field("variables");
    index = 0;
    while (index < vars->count() && index < 64) {
        item = vars->at(index);
        local = new DebugVar();
        string_set(local->name, item->field("name")->text());
        string_set(local->value, item->field("value")->text());
        if (same_text(item->field("arg")->text(), "1"))
            local->argument = 1;
        locals->add(local);
        index = index + 1;
    }
    if (vars->count() > 64)
        append_console("locals truncated to 64\n");
}

void DebugSession::apply_breaks(void) {
    MiValue *body;
    MiValue *item;
    DebugBreak *point;
    long index;
    const char *addr;

    breaks = new BreakVec();
    body = lastValue->field("BreakpointTable")->field("body");
    index = 0;
    while (index < body->count() && index < 256) {
        item = body->at(index);
        point = new DebugBreak();
        string_set(point->number, item->field("number")->text());
        string_set(point->file, item->field("file")->text());
        string_set(
                point->fullname,
                item->field("fullname")->text());
        string_set(point->func, item->field("func")->text());
        string_set(point->addr, item->field("addr")->text());
        string_set(point->condition, item->field("cond")->text());
        point->line = (int)strtol(
                item->field("line")->text(),
                nullptr,
                10);
        point->hits = (int)strtol(
                item->field("times")->text(),
                nullptr,
                10);
        point->enabled = same_text(
                item->field("enabled")->text(),
                "y");
        addr = point->addr->c_str();
        if (item->field("pending")->text()[0] != 0
                || same_text(addr, "<PENDING>"))
            point->pending = 1;
        breaks->add(point);
        index = index + 1;
    }
}

void DebugSession::apply_threads(void) {
    MiValue *list;
    MiValue *item;
    DebugThread *thread;
    long index;

    threads = new ThreadVec();
    list = lastValue->field("threads");
    index = 0;
    while (index < list->count() && index < 64) {
        item = list->at(index);
        thread = new DebugThread();
        string_set(thread->id, item->field("id")->text());
        string_set(thread->name, item->field("name")->text());
        string_set(
                thread->target,
                item->field("target-id")->text());
        threads->add(thread);
        index = index + 1;
    }
}

void DebugSession::refresh_stack(void) {
    transact("-stack-list-frames 0 30", PURPOSE_FRAMES);
    apply_frames();
}

void DebugSession::refresh_locals(void) {
    transact(
            "-stack-list-variables --all-values",
            PURPOSE_LOCALS);
    apply_locals();
}

void DebugSession::refresh_breaks(void) {
    transact("-break-list", PURPOSE_BREAKS);
    apply_breaks();
}

void DebugSession::refresh_threads(void) {
    transact("-thread-info", PURPOSE_THREADS);
    apply_threads();
}

int DebugSession::rejected(const char *expr) {
    int index;

    if (expr == nullptr || expr[0] == 0)
        return 1;
    index = 0;
    while (expr[index] != 0) {
        if (expr[index] == '(' || expr[index] == ')'
                || expr[index] == '=')
            return 1;
        if (expr[index] == '+' && expr[index + 1] == '+')
            return 1;
        if (expr[index] == '-' && expr[index + 1] == '-')
            return 1;
        index = index + 1;
    }
    return 0;
}

void DebugSession::refresh_watches(void) {
    DebugWatch *watch;
    String *command;
    String *quoted;
    long index;

    index = 0;
    while (index < watches->size()) {
        watch = watches->at(index);
        if (rejected(watch->expression->c_str())) {
            string_set(watch->value, "");
            string_set(
                    watch->error,
                    "calls, assignment, and increment are rejected");
        } else {
            command = new String();
            quoted = parser->quote(watch->expression->c_str());
            command->append("-data-evaluate-expression ");
            command->append(quoted->c_str());
            if (try_transact(command->c_str(), PURPOSE_WATCH)) {
                string_set(
                        watch->value,
                        lastValue->field("value")->text());
                string_set(watch->error, "");
            } else {
                string_set(watch->value, "");
                string_set(watch->error, lastMsg->c_str());
            }
        }
        index = index + 1;
    }
}

void DebugSession::add_watch(const char *expr) {
    DebugWatch *watch;

    if (watches->size() >= 64)
        fail("DBG1000", "at most 64 watches");
    watch = new DebugWatch();
    if (expr == nullptr)
        expr = "";
    string_set(watch->expression, expr);
    watches->add(watch);
    if (state != DEBUG_STOPPED)
        return;
    if (should_queue() != 0) {
        submit_watch((int)watches->size() - 1, RANK_HIGH);
        return;
    }
    refresh_watches();
}

void DebugSession::remove_watch(long index) {
    if (index < 0 || index >= watches->size())
        fail("DBG1000", "no such watch");
    watches->remove(index);
}

void DebugSession::select_frame(int level) {
    String *command;

    if (state != DEBUG_STOPPED)
        fail("DBG1000", "the program is not stopped");
    command = new String();
    command->append("-stack-select-frame ");
    command->append(format("{}", level));
    if (defer_job(
            command->c_str(),
            PURPOSE_FRAME,
            level) != 0)
        return;
    transact(command->c_str(), PURPOSE_OTHER);
    selectedFrame = level;
    refresh_locals();
    refresh_watches();
    if (level >= 0 && level < (int)frames->size()) {
        string_set(stopFile, frames->at(level)->file->c_str());
        string_set(
                stopFull,
                frames->at(level)->fullname->c_str());
        string_set(stopFunc, frames->at(level)->func->c_str());
        stopLine = frames->at(level)->line;
    }
}

void DebugSession::select_thread(const char *id) {
    String *command;

    if (state != DEBUG_STOPPED)
        fail("DBG1000", "the program is not stopped");
    command = new String();
    command->append("-thread-select ");
    command->append(id);
    if (defer_job(
            command->c_str(),
            PURPOSE_THREAD,
            0) != 0)
        return;
    transact(command->c_str(), PURPOSE_OTHER);
    selectedFrame = 0;
    refresh_stack();
    refresh_locals();
    refresh_watches();
}

void DebugSession::prepare_frame(void) {
    if (selectedFrame == 0)
        return;
    transact("-stack-select-frame 0", PURPOSE_OTHER);
    selectedFrame = 0;
}

void DebugSession::snapshot_hits(void) {
    HitSnap *snap;
    long index;

    snaps = new SnapVec();
    if (state == DEBUG_EMPTY)
        return;
    refresh_breaks();
    index = 0;
    while (index < breaks->size()) {
        snap = new HitSnap();
        string_set(snap->number, breaks->at(index)->number->c_str());
        snap->hits = breaks->at(index)->hits;
        snap->enabled = breaks->at(index)->enabled;
        snaps->add(snap);
        index = index + 1;
    }
}

void DebugSession::report_unreached(void) {
    if (try_transact("-break-list", PURPOSE_BREAKS) == 0)
        return;
    apply_breaks();
    count_unreached();
}

void DebugSession::count_unreached(void) {
    HitSnap *snap;
    DebugBreak *point;
    long index;
    long cursor;
    int found;

    missedCount = 0;
    index = 0;
    while (index < snaps->size()) {
        snap = snaps->at(index);
        if (snap->enabled) {
            found = 0;
            cursor = 0;
            point = nullptr;
            while (cursor < breaks->size()) {
                if (same_text(
                        breaks->at(cursor)->number->c_str(),
                        snap->number->c_str())) {
                    point = breaks->at(cursor);
                    found = 1;
                }
                cursor = cursor + 1;
            }
            if (found && point->hits == snap->hits) {
                missedCount = missedCount + 1;
                append_console(
                        "Not reached during this run ");
                append_console(snap->number->c_str());
                append_console(" ");
                append_console(point->file->c_str());
                append_console(":");
                append_console(format("{}", point->line));
                append_console(
                        " (that code did not execute)\n");
            }
        }
        index = index + 1;
    }
}

int DebugSession::same_place(void) {
    if (havePrev == 0)
        return 0;
    if (prevLine != stopLine)
        return 0;
    if (same_text(prevFile->c_str(), stopFile->c_str()) == 0)
        return 0;
    if (same_text(prevFunc->c_str(), stopFunc->c_str()) == 0)
        return 0;
    return 1;
}

void DebugSession::update_status(void) {
    int atStart;

    string_set(status, "");
    if (state == DEBUG_EMPTY) {
        status->append("No target");
    } else if (state == DEBUG_LOADED) {
        status->append("Loaded ");
        status->append(executable->c_str());
    } else if (state == DEBUG_RUNNING) {
        status->append("Running");
    } else if (state == DEBUG_EXITED) {
        status->append("Exited");
        if (haveExit) {
            status->append(" ");
            status->append(format("{}", exitCode));
        }
        if (missedCount > 0) {
            status->append(". Not reached: ");
            status->append(format("{}", missedCount));
        }
    } else {
        atStart = 0;
        if (startBreak->size() > 0
                && same_text(
                    stopBkpt->c_str(),
                    startBreak->c_str()))
            atStart = 1;
        if (atStart) {
            status->append("Stopped at start");
        } else {
            status->append("Stopped at ");
            status->append(stopFile->c_str());
            status->append(":");
            status->append(format("{}", stopLine));
            status->append(" in ");
            status->append(stopFunc->c_str());
            status->append(" (");
            status->append(stopReason->c_str());
            status->append(")");
        }
        if (same_place()) {
            status->append(" same source line");
            if (prevAddr->size() > 0) {
                status->append(" previous ");
                status->append(prevAddr->c_str());
            }
        }
        string_set(prevFile, stopFile->c_str());
        string_set(prevFunc, stopFunc->c_str());
        string_set(prevAddr, stopAddr->c_str());
        prevLine = stopLine;
        havePrev = 1;
    }
}

void DebugSession::reset_driver(void) {
    highQ = new JobVec();
    lowQ = new JobVec();
    active = nullptr;
    phase = PHASE_IDLE;
    ignoreActive = 0;
    strictFailed = 0;
}

void DebugSession::reset_error(void) {
    strictFailed = 0;
    string_set(commandError, "");
}

void DebugSession::flush_low(void) {
    lowQ = new JobVec();
    if (active != nullptr && active->rank == RANK_LOW)
        ignoreActive = 1;
}

int DebugSession::is_idle(void) {
    if (phase != PHASE_IDLE)
        return 0;
    if (active != nullptr)
        return 0;
    if (highQ->size() > 0)
        return 0;
    if (lowQ->size() > 0)
        return 0;
    return 1;
}

int DebugSession::accepts_user(void) {
    if (highQ->size() > 0)
        return 0;
    if (phase == PHASE_STOP)
        return 1;
    if (active != nullptr
            && active->rank == RANK_HIGH
            && ignoreActive == 0)
        return 0;
    return 1;
}

int DebugSession::can_step(void) {
    if (state != DEBUG_STOPPED)
        return 0;
    return accepts_user();
}

int DebugSession::can_run(void) {
    if (accepts_user() == 0)
        return 0;
    if (state == DEBUG_LOADED || state == DEBUG_EXITED)
        return 1;
    if (state == DEBUG_STOPPED)
        return 1;
    return 0;
}

int DebugSession::can_break(void) {
    if (state == DEBUG_RUNNING)
        return 1;
    return 0;
}

int DebugSession::can_edit(void) {
    if (state == DEBUG_EMPTY || state == DEBUG_RUNNING)
        return 0;
    return accepts_user();
}

int DebugSession::should_queue(void) {
    if (yield == 0)
        return 0;
    if (is_idle() != 0)
        return 0;
    return 1;
}

int DebugSession::defer_job(
        const char *command,
        int purpose,
        int extra) {
    if (should_queue() == 0)
        return 0;
    reset_error();
    submit(
            command,
            purpose,
            RANK_HIGH,
            JOB_QUERY,
            FOLLOW_NONE,
            0,
            extra);
    return 1;
}

DebugJob *DebugSession::make_job(
        const char *text,
        int purpose,
        int rank,
        int kind,
        int follow,
        int soft,
        int extra) {
    DebugJob *job;

    job = new DebugJob();
    if (text == nullptr)
        text = "";
    string_set(job->text, text);
    job->purpose = purpose;
    job->rank = rank;
    job->kind = kind;
    job->follow = follow;
    job->soft = soft;
    job->extra = extra;
    return job;
}

int DebugSession::queued_low(const char *text) {
    long index;

    if (text == nullptr)
        return 1;
    if (active != nullptr
            && ignoreActive == 0
            && active->rank == RANK_LOW
            && same_text(active->text->c_str(), text))
        return 1;
    index = 0;
    while (index < lowQ->size()) {
        if (same_text(lowQ->at(index)->text->c_str(), text))
            return 1;
        index = index + 1;
    }
    return 0;
}

void DebugSession::submit(
        const char *text,
        int purpose,
        int rank,
        int kind,
        int follow,
        int soft,
        int extra) {
    DebugJob *job;

    if (text == nullptr || text[0] == 0)
        return;
    if (rank == RANK_LOW && queued_low(text) != 0)
        return;
    job = make_job(
            text,
            purpose,
            rank,
            kind,
            follow,
            soft,
            extra);
    if (rank == RANK_HIGH)
        highQ->add(job);
    else
        lowQ->add(job);
    if (phase == PHASE_IDLE && active == nullptr)
        dispatch();
}

void DebugSession::dispatch(void) {
    DebugJob *job;

    if (phase != PHASE_IDLE || active != nullptr)
        return;
    if (strictFailed != 0)
        return;
    if (highQ->size() > 0) {
        job = highQ->at(0);
        highQ->remove(0);
    } else if (lowQ->size() > 0) {
        job = lowQ->at(0);
        lowQ->remove(0);
    } else {
        return;
    }
    active = job;
    seenResult = resultSerial;
    seenStop = stopSerial;
    seenExit = exitSerial;
    issue(job->text->c_str(), job->purpose);
    phase = PHASE_RESULT;
}

void DebugSession::note_stage(const char *name) {
    if (name == nullptr || name[0] == 0)
        return;
    if (fillLog->find(name) >= 0)
        return;
    if (fillLog->size() > 0)
        fillLog->append(" ");
    fillLog->append(name);
}

void DebugSession::take_snap(void) {
    HitSnap *snap;
    long index;

    snaps = new SnapVec();
    index = 0;
    while (index < breaks->size()) {
        snap = new HitSnap();
        string_set(
                snap->number,
                breaks->at(index)->number->c_str());
        snap->hits = breaks->at(index)->hits;
        snap->enabled = breaks->at(index)->enabled;
        snaps->add(snap);
        index = index + 1;
    }
}

int DebugSession::stop_readable(void) {
    if (stopFull->size() == 0)
        return 0;
    if (access(stopFull->c_str(), R_OK) != 0)
        return 0;
    return 1;
}

int DebugSession::hop_over(void) {
    if (stepping != FOLLOW_OVER)
        return 0;
    if (hops >= 8)
        return 0;
    if (state != DEBUG_STOPPED)
        return 0;
    if (same_text(
            stopReason->c_str(),
            "end-stepping-range") == 0)
        return 0;
    if (stopLine != hopLine)
        return 0;
    if (same_text(stopFile->c_str(), hopFile->c_str()) == 0)
        return 0;
    if (same_text(stopFunc->c_str(), hopFunc->c_str()) == 0)
        return 0;
    hops = hops + 1;
    return 1;
}

int DebugSession::hop_into(void) {
    if (stepping != FOLLOW_INTO)
        return 0;
    if (hops >= 8)
        return 0;
    if (state != DEBUG_STOPPED)
        return 0;
    if (stop_readable() != 0)
        return 0;
    if (same_text(stopReason->c_str(), "breakpoint-hit"))
        return 0;
    hops = hops + 1;
    return 1;
}

void DebugSession::submit_watch(int index, int rank) {
    DebugWatch *watch;
    String *command;
    String *quoted;

    if (index < 0 || index >= (int)watches->size())
        return;
    watch = watches->at(index);
    if (rejected(watch->expression->c_str()) != 0) {
        string_set(watch->value, "");
        string_set(
                watch->error,
                "calls, assignment, and increment are rejected");
        note_stage("watches");
        return;
    }
    command = new String();
    quoted = parser->quote(watch->expression->c_str());
    command->append("-data-evaluate-expression ");
    command->append(quoted->c_str());
    submit(
            command->c_str(),
            PURPOSE_WATCH,
            rank,
            JOB_QUERY,
            FOLLOW_NONE,
            1,
            index);
}

void DebugSession::enqueue_runtime(void) {
    String *command;
    String *quoted;
    long index;

    if (directory->size() > 0) {
        command = new String();
        quoted = parser->quote(directory->c_str());
        command->append("-environment-cd ");
        command->append(quoted->c_str());
        submit(
                command->c_str(),
                PURPOSE_OTHER,
                RANK_HIGH,
                JOB_QUERY,
                FOLLOW_NONE,
                0,
                0);
    }
    index = 0;
    while (index < environment->pairs->size()) {
        command = new String();
        command->append("-gdb-set environment ");
        command->append(
                environment->pairs->at(index)->name->c_str());
        command->append(" ");
        quoted = parser->quote(
                environment->pairs->at(index)->value->c_str());
        command->append(quoted->c_str());
        submit(
                command->c_str(),
                PURPOSE_OTHER,
                RANK_HIGH,
                JOB_QUERY,
                FOLLOW_NONE,
                0,
                0);
        index = index + 1;
    }
    command = new String();
    command->append("-exec-arguments");
    index = 0;
    while (index < arguments->values->size()) {
        command->append(" ");
        quoted = parser->quote(
                arguments->values->at(index)->c_str());
        command->append(quoted->c_str());
        index = index + 1;
    }
    submit(
            command->c_str(),
            PURPOSE_OTHER,
            RANK_HIGH,
            JOB_QUERY,
            FOLLOW_NONE,
            0,
            0);
}

void DebugSession::enqueue_fill(void) {
    long index;

    string_set(fillLog, "");
    submit(
            "-stack-list-frames 0 30",
            PURPOSE_FRAMES,
            RANK_LOW,
            JOB_QUERY,
            FOLLOW_NONE,
            0,
            0);
    submit(
            "-break-list",
            PURPOSE_BREAKS,
            RANK_LOW,
            JOB_QUERY,
            FOLLOW_NONE,
            0,
            0);
    submit(
            "-thread-info",
            PURPOSE_THREADS,
            RANK_LOW,
            JOB_QUERY,
            FOLLOW_NONE,
            0,
            0);
    submit(
            "-stack-list-variables --all-values",
            PURPOSE_LOCALS,
            RANK_LOW,
            JOB_QUERY,
            FOLLOW_NONE,
            0,
            0);
    index = 0;
    while (index < watches->size() && index < 64) {
        submit_watch((int)index, RANK_LOW);
        index = index + 1;
    }
}

void DebugSession::enqueue_fresh(void) {
    reset_error();
    havePrev = 0;
    string_set(startBreak, "");
    missedCount = 0;
    stepping = FOLLOW_STOP;
    hops = 0;
    sawExec = 0;
    flush_low();
    submit(
            "-break-list",
            PURPOSE_SNAP,
            RANK_HIGH,
            JOB_QUERY,
            FOLLOW_NONE,
            0,
            0);
    enqueue_runtime();
    if (breakAtStart != 0) {
        submit(
                "-break-insert -t main",
                PURPOSE_START,
                RANK_HIGH,
                JOB_QUERY,
                FOLLOW_NONE,
                1,
                0);
    }
    submit(
            "-exec-run",
            PURPOSE_RUN,
            RANK_HIGH,
            JOB_EXEC,
            FOLLOW_STOP,
            0,
            0);
}

void DebugSession::apply_query(DebugJob *job) {
    int index;
    const char *number;

    if (job == nullptr)
        return;
    if (job->purpose == PURPOSE_FRAMES) {
        if (lastOk != 0)
            apply_frames();
        note_stage("stack");
        return;
    }
    if (job->purpose == PURPOSE_BREAKS) {
        if (lastOk != 0)
            apply_breaks();
        note_stage("breaks");
        return;
    }
    if (job->purpose == PURPOSE_THREADS) {
        if (lastOk != 0)
            apply_threads();
        note_stage("threads");
        return;
    }
    if (job->purpose == PURPOSE_LOCALS) {
        if (lastOk != 0)
            apply_locals();
        note_stage("locals");
        return;
    }
    if (job->purpose == PURPOSE_WATCH) {
        index = job->extra;
        if (index >= 0 && index < (int)watches->size()) {
            if (lastOk != 0) {
                string_set(
                        watches->at(index)->value,
                        lastValue->field("value")->text());
                string_set(watches->at(index)->error, "");
            } else {
                string_set(watches->at(index)->value, "");
                string_set(
                        watches->at(index)->error,
                        lastMsg->c_str());
            }
        }
        note_stage("watches");
        return;
    }
    if (job->purpose == PURPOSE_SNAP) {
        if (lastOk != 0) {
            apply_breaks();
            take_snap();
        }
        return;
    }
    if (job->purpose == PURPOSE_START) {
        if (lastOk != 0) {
            number = lastValue->field("bkpt")->field(
                    "number")->text();
            string_set(startBreak, number);
        } else {
            append_console("Break at start unavailable\n");
        }
        return;
    }
    if (job->purpose == PURPOSE_UNREACHED) {
        if (lastOk != 0) {
            apply_breaks();
            count_unreached();
        }
        update_status();
        return;
    }
    if (job->purpose == PURPOSE_FRAME0) {
        selectedFrame = 0;
        return;
    }
    if (job->purpose == PURPOSE_FRAME) {
        selectedFrame = job->extra;
        if (job->extra >= 0
                && job->extra < (int)frames->size()) {
            string_set(
                    stopFile,
                    frames->at(job->extra)->file->c_str());
            string_set(
                    stopFull,
                    frames->at(job->extra)->fullname->c_str());
            string_set(
                    stopFunc,
                    frames->at(job->extra)->func->c_str());
            stopLine = frames->at(job->extra)->line;
        }
        submit(
                "-stack-list-variables --all-values",
                PURPOSE_LOCALS,
                RANK_LOW,
                JOB_QUERY,
                FOLLOW_NONE,
                0,
                0);
        index = 0;
        while (index < (int)watches->size() && index < 64) {
            submit_watch(index, RANK_LOW);
            index = index + 1;
        }
        return;
    }
    if (job->purpose == PURPOSE_THREAD) {
        selectedFrame = 0;
        submit(
                "-stack-list-frames 0 30",
                PURPOSE_FRAMES,
                RANK_LOW,
                JOB_QUERY,
                FOLLOW_NONE,
                0,
                0);
        submit(
                "-stack-list-variables --all-values",
                PURPOSE_LOCALS,
                RANK_LOW,
                JOB_QUERY,
                FOLLOW_NONE,
                0,
                0);
        index = 0;
        while (index < (int)watches->size() && index < 64) {
            submit_watch(index, RANK_LOW);
            index = index + 1;
        }
        return;
    }
    if (job->purpose == PURPOSE_BREAK_CMD) {
        if (lastOk != 0) {
            number = lastValue->field("bkpt")->field(
                    "number")->text();
            if (number[0] != 0)
                string_set(lastNumber, number);
            submit(
                    "-break-list",
                    PURPOSE_BREAKS,
                    RANK_LOW,
                    JOB_QUERY,
                    FOLLOW_NONE,
                    0,
                    0);
        }
        return;
    }
}

void DebugSession::finish_exec(DebugJob *job) {
    int follow;

    follow = FOLLOW_STOP;
    if (job != nullptr)
        follow = job->follow;
    active = nullptr;
    phase = PHASE_IDLE;
    if (state == DEBUG_EXITED) {
        submit(
                "-break-list",
                PURPOSE_UNREACHED,
                RANK_HIGH,
                JOB_QUERY,
                FOLLOW_NONE,
                1,
                0);
        if (phase == PHASE_IDLE)
            dispatch();
        return;
    }
    if (state != DEBUG_STOPPED) {
        if (phase == PHASE_IDLE)
            dispatch();
        return;
    }
    if (follow == FOLLOW_OVER && hop_over() != 0) {
        submit(
                "-exec-next",
                PURPOSE_STEP,
                RANK_HIGH,
                JOB_EXEC,
                FOLLOW_OVER,
                0,
                0);
        if (phase == PHASE_IDLE)
            dispatch();
        return;
    }
    if (follow == FOLLOW_INTO && hop_into() != 0) {
        submit(
                "-exec-finish",
                PURPOSE_STEP,
                RANK_HIGH,
                JOB_EXEC,
                FOLLOW_INTO,
                1,
                0);
        if (phase == PHASE_IDLE)
            dispatch();
        return;
    }
    if (stepping == FOLLOW_INTO && hops > 0) {
        append_console("skipped ");
        append_console(format("{}", hops));
        append_console(" sourceless frames\n");
    }
    stepping = FOLLOW_NONE;
    selectedFrame = 0;
    update_status();
    enqueue_fill();
    if (phase == PHASE_IDLE)
        dispatch();
}

void DebugSession::handle_result(void) {
    DebugJob *job;
    int ok;

    job = active;
    ok = lastOk;
    if (job == nullptr) {
        phase = PHASE_IDLE;
        dispatch();
        return;
    }
    if (ignoreActive != 0) {
        ignoreActive = 0;
        active = nullptr;
        phase = PHASE_IDLE;
        dispatch();
        return;
    }
    if (job->kind == JOB_EXEC)
        sawExec = 1;
    if (ok == 0) {
        if (job->soft != 0) {
            if (job->kind == JOB_EXEC) {
                job->follow = FOLLOW_STOP;
                finish_exec(job);
                return;
            }
            apply_query(job);
            active = nullptr;
            phase = PHASE_IDLE;
            dispatch();
            return;
        }
        if (lastMsg->size() > 0)
            string_set(commandError, lastMsg->c_str());
        else
            string_set(commandError, "GDB rejected the command");
        strictFailed = 1;
        active = nullptr;
        phase = PHASE_IDLE;
        highQ = new JobVec();
        lowQ = new JobVec();
        return;
    }
    if (job->kind == JOB_EXEC) {
        if (state == DEBUG_RUNNING
                && stopSerial == seenStop
                && exitSerial == seenExit) {
            phase = PHASE_STOP;
            update_status();
            return;
        }
        finish_exec(job);
        return;
    }
    active = nullptr;
    phase = PHASE_IDLE;
    apply_query(job);
    if (phase == PHASE_IDLE)
        dispatch();
}

void DebugSession::service(int timeoutMs) {
    if (timeoutMs < 0)
        timeoutMs = 0;
    if (fromGdb < 0) {
        phase = PHASE_IDLE;
        active = nullptr;
        highQ = new JobVec();
        lowQ = new JobVec();
        return;
    }
    if (phase == PHASE_IDLE)
        dispatch();
    if (phase == PHASE_IDLE)
        return;
    pump(timeoutMs);
    if (gdbDead != 0) {
        phase = PHASE_IDLE;
        active = nullptr;
        highQ = new JobVec();
        lowQ = new JobVec();
        fail("DBG3002", "GDB exited");
    }
    if (phase == PHASE_RESULT && resultSerial != seenResult)
        handle_result();
    else if (phase == PHASE_STOP
            && (stopSerial != seenStop
                || exitSerial != seenExit))
        finish_exec(active);
}

void DebugSession::until_running(void) {
    long start;

    start = now_ms();
    while (strictFailed == 0 && sawExec == 0) {
        if (now_ms() - start > 15000)
            fail("DBG3002", "GDB did not stop");
        service(50);
    }
    if (strictFailed != 0)
        fail("DBG3002", commandError->c_str());
}

void DebugSession::settle(int timeoutMs) {
    long start;

    start = now_ms();
    while (is_idle() == 0) {
        if (now_ms() - start > timeoutMs)
            fail("DBG3002", "GDB did not stop");
        service(50);
    }
    if (strictFailed != 0)
        fail("DBG3002", commandError->c_str());
}

void DebugSession::start_step(const char *exec, int follow) {
    if (state != DEBUG_STOPPED)
        fail("DBG1000", "the program is not stopped");
    if (accepts_user() == 0)
        fail("DBG1000", "a command is still queued");
    reset_error();
    flush_low();
    stepping = follow;
    hops = 0;
    if (follow == FOLLOW_OVER)
        hops = 1;
    hopLine = stopLine;
    string_set(hopFile, stopFile->c_str());
    string_set(hopFunc, stopFunc->c_str());
    if (selectedFrame != 0) {
        submit(
                "-stack-select-frame 0",
                PURPOSE_FRAME0,
                RANK_HIGH,
                JOB_QUERY,
                FOLLOW_NONE,
                0,
                0);
    }
    submit(
            exec,
            PURPOSE_STEP,
            RANK_HIGH,
            JOB_EXEC,
            follow,
            0,
            0);
}

void DebugSession::interrupt_now(void) {
    DebugJob *job;

    if (state != DEBUG_RUNNING)
        fail("DBG1000", "the program is not running");
    if (phase != PHASE_STOP)
        fail("DBG1000", "the program is not running");
    stepping = FOLLOW_STOP;
    hops = 0;
    active = nullptr;
    job = make_job(
            "-exec-interrupt",
            PURPOSE_STEP,
            RANK_HIGH,
            JOB_EXEC,
            FOLLOW_STOP,
            0,
            0);
    active = job;
    seenResult = resultSerial;
    seenStop = stopSerial;
    seenExit = exitSerial;
    issue("-exec-interrupt", PURPOSE_STEP);
    phase = PHASE_RESULT;
}

void DebugSession::queue_refresh(void) {
    if (state != DEBUG_STOPPED)
        return;
    enqueue_fill();
}

void DebugSession::begin_run(void) {
    if (state == DEBUG_EMPTY)
        fail("DBG1000", "no target is loaded");
    if (state == DEBUG_RUNNING)
        fail("DBG1000", "the program is already running");
    enqueue_fresh();
    if (yield == 0)
        until_running();
}

void DebugSession::wait_until_stop(void) {
    settle(60000);
}

void DebugSession::run_program(void) {
    if (state == DEBUG_STOPPED) {
        continue_program();
        return;
    }
    begin_run();
    if (yield == 0)
        settle(60000);
}

void DebugSession::continue_program(void) {
    start_step("-exec-continue", FOLLOW_STOP);
    if (yield == 0)
        settle(60000);
}

void DebugSession::step_over(void) {
    start_step("-exec-next", FOLLOW_OVER);
    if (yield == 0)
        settle(120000);
}

void DebugSession::step_into(void) {
    start_step("-exec-step", FOLLOW_INTO);
    if (yield == 0)
        settle(120000);
}

void DebugSession::step_out(void) {
    start_step("-exec-finish", FOLLOW_STOP);
    if (yield == 0)
        settle(60000);
}

void DebugSession::interrupt_program(void) {
    interrupt_now();
    if (yield == 0)
        settle(20000);
}

void DebugSession::restart_program(void) {
    if (state == DEBUG_RUNNING) {
        interrupt_now();
        if (yield == 0)
            settle(20000);
    }
    if (state == DEBUG_EMPTY)
        fail("DBG1000", "no target is loaded");
    begin_run();
    if (yield == 0)
        settle(60000);
}
