#ifndef DBG_SESSION
#define DBG_SESSION

/* Local GDB/MI session. One command is in flight. User
 * commands sit on a high-priority queue and may cancel a
 * low-priority refresh. A refresh after a stop is stack,
 * breakpoints, threads, locals, then watches. yield leaves
 * the wait to the caller, so the GTK loop can keep running.
 * Pause sends -exec-interrupt while the inferior runs.
 * Program output is the target stream plus raw lines that
 * GDB does not wrap. There is no pseudo-terminal. */

#include <errno>
#include <fcntl>
#include <select>
#include <signal>
#include <spawn>
#include <time>
#include <unistd>
#include "mi.shpp"
#include "settings.shpp"

enum {
    DEBUG_EMPTY,
    DEBUG_LOADED,
    DEBUG_RUNNING,
    DEBUG_STOPPED,
    DEBUG_EXITED
};

enum {
    PURPOSE_NONE,
    PURPOSE_SETUP,
    PURPOSE_LOAD,
    PURPOSE_RUN,
    PURPOSE_STEP,
    PURPOSE_FRAMES,
    PURPOSE_LOCALS,
    PURPOSE_THREADS,
    PURPOSE_BREAKS,
    PURPOSE_WATCH,
    PURPOSE_OTHER,
    PURPOSE_SNAP,
    PURPOSE_START,
    PURPOSE_UNREACHED,
    PURPOSE_FRAME0,
    PURPOSE_FRAME,
    PURPOSE_THREAD,
    PURPOSE_BREAK_CMD
};

enum {
    RANK_HIGH,
    RANK_LOW
};

enum {
    JOB_QUERY,
    JOB_EXEC
};

enum {
    FOLLOW_NONE,
    FOLLOW_STOP,
    FOLLOW_OVER,
    FOLLOW_INTO
};

enum {
    PHASE_IDLE,
    PHASE_RESULT,
    PHASE_STOP
};

class DebugBreak {
public:
    DebugBreak();
    String *number;
    String *file;
    String *fullname;
    String *func;
    String *addr;
    String *condition;
    int line;
    int enabled;
    int pending;
    int hits;
};

class DebugFrame {
public:
    DebugFrame();
    String *func;
    String *file;
    String *fullname;
    String *addr;
    int level;
    int line;
};

class DebugVar {
public:
    DebugVar();
    String *name;
    String *value;
    int argument;
};

class DebugWatch {
public:
    DebugWatch();
    String *expression;
    String *value;
    String *error;
};

class DebugThread {
public:
    DebugThread();
    String *id;
    String *name;
    String *target;
};

class HitSnap {
public:
    HitSnap();
    String *number;
    int hits;
    int enabled;
};

class DebugJob {
public:
    DebugJob();
    String *text;
    int purpose;
    int rank;
    int kind;
    int follow;
    int soft;
    int extra;
};

VECTOR(BreakVec, DebugBreak *)
VECTOR(FrameVec, DebugFrame *)
VECTOR(VarVec, DebugVar *)
VECTOR(WatchList, DebugWatch *)
VECTOR(ThreadVec, DebugThread *)
VECTOR(SnapVec, HitSnap *)
VECTOR(JobVec, DebugJob *)

class DebugSession {
public:
    DebugSession();
    ~DebugSession();
    void open_gdb(const char *path);
    void close_gdb(void);
    void load_program(const char *path);
    void set_arguments(const char *text);
    void set_directory(const char *path);
    void set_environment(const char *text);
    void insert_breakpoint(const char *file, int line);
    void delete_breakpoint(const char *number);
    void enable_breakpoint(const char *number, int enabled);
    void set_condition(const char *number, const char *expr);
    void set_ignore(const char *number, int count);
    void begin_run(void);
    void wait_until_stop(void);
    void run_program(void);
    void continue_program(void);
    void step_into(void);
    void step_over(void);
    void step_out(void);
    void interrupt_program(void);
    void restart_program(void);
    void queue_refresh(void);
    void service(int timeoutMs);
    int is_idle(void);
    int accepts_user(void);
    int can_step(void);
    int can_run(void);
    int can_break(void);
    int can_edit(void);
    void refresh_stack(void);
    void refresh_locals(void);
    void refresh_breaks(void);
    void refresh_threads(void);
    void refresh_watches(void);
    void select_frame(int level);
    void select_thread(const char *id);
    void add_watch(const char *expr);
    void remove_watch(long index);
    void note_temp(const char *dir, const char *exe);
    void update_status(void);
    int state;
    int breakAtStart;
    int selectedFrame;
    int stopLine;
    int exitCode;
    int haveExit;
    int missedCount;
    int sawPrompt;
    String *status;
    String *console;
    String *program;
    String *errorText;
    String *executable;
    String *stopFile;
    String *stopFull;
    String *stopFunc;
    String *stopReason;
    String *stopAddr;
    String *stopBkpt;
    String *lastNumber;
    String *directory;
    BreakVec *breaks;
    FrameVec *frames;
    VarVec *locals;
    WatchList *watches;
    ThreadVec *threads;
    ArgumentList *arguments;
    EnvironmentList *environment;
    void fail(const char *code, const char *text);
    void transact(const char *command, int purpose);
    int try_transact(const char *command, int purpose);
    void issue(const char *command, int purpose);
    void wait_result(int timeoutMs);
    void wait_stop(int timeoutMs, int stops, int exits);
    void pump(int timeoutMs);
    void write_all(const char *text);
    void accept_bytes(const char *bytes, long count, int asError);
    void drain(String *pending, int asError);
    void accept_line(const char *line);
    void append_console(const char *text);
    void append_program(const char *text);
    void apply_frames(void);
    void apply_locals(void);
    void apply_breaks(void);
    void apply_threads(void);
    void snapshot_hits(void);
    void report_unreached(void);
    void prepare_frame(void);
    void send_runtime(void);
    int rejected(const char *expr);
    int same_place(void);
    long now_ms(void);
    MiParser *parser;
    MiValue *lastValue;
    String *lastMsg;
    String *pendingOut;
    String *pendingErr;
    String *prevFile;
    String *prevFunc;
    String *prevAddr;
    String *startBreak;
    String *ownedDir;
    String *ownedExe;
    SnapVec *snaps;
    int waitingToken;
    int waitingPurpose;
    int resultSerial;
    int stopSerial;
    int exitSerial;
    int lastOk;
    int prevLine;
    int havePrev;
    int runStops;
    int runExits;
    int toGdb;
    int fromGdb;
    int fromErr;
    int gdbPid;
    int inferiorPid;
    int gdbDead;
    int yield;
    int phase;
    int ignoreActive;
    int strictFailed;
    int stepping;
    int hops;
    int hopLine;
    int recordCommands;
    int seenResult;
    int seenStop;
    int seenExit;
    int sawExec;
    JobVec *highQ;
    JobVec *lowQ;
    DebugJob *active;
    String *hopFile;
    String *hopFunc;
    String *fillLog;
    String *commandTrace;
    String *commandError;
    void reset_driver(void);
    void reset_error(void);
    void flush_low(void);
    int should_queue(void);
    int defer_job(const char *command, int purpose, int extra);
    void submit(
            const char *text,
            int purpose,
            int rank,
            int kind,
            int follow,
            int soft,
            int extra);
    void dispatch(void);
    void handle_result(void);
    void finish_exec(DebugJob *job);
    void apply_query(DebugJob *job);
    void enqueue_fresh(void);
    void enqueue_runtime(void);
    void enqueue_fill(void);
    void start_step(const char *exec, int follow);
    void interrupt_now(void);
    void until_running(void);
    void settle(int timeoutMs);
    void take_snap(void);
    void count_unreached(void);
    void submit_watch(int index, int rank);
    void note_stage(const char *name);
    int hop_over(void);
    int hop_into(void);
    int stop_readable(void);
    int queued_low(const char *text);
    DebugJob *make_job(
            const char *text,
            int purpose,
            int rank,
            int kind,
            int follow,
            int soft,
            int extra);
};

#endif
