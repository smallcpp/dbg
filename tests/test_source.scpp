#include "../src/source.scpp"
#include <stdio>

int main(void) {
    SourceText *source;
    File *out;
    int breaks[2];
    String *view;
    const char *path;

    path = "/tmp/dbg-source.txt";
    out = fopen(path, "w");
    if (out == nullptr)
        return 1;
    fputs("alpha\nbeta alpha\n", out);
    fclose(out);
    source = new SourceText();
    if (require_test(source->load(path), "load") == 0)
        return 1;
    if (require_test(source->find_next("alpha", 0), "find") == 0)
        return 1;
    if (require_test(source->matchAt == 0, "first") == 0)
        return 1;
    if (require_test(
            source->find_next("alpha", 1),
            "second") == 0)
        return 1;
    if (require_test(source->line_of(source->matchAt) == 2,
            "line") == 0)
        return 1;
    if (require_test(source->find_next("alpha", 20), "wrap") == 0)
        return 1;
    if (require_test(
            same_text(source->note->c_str(), "Wrapped"),
            "wrapped") == 0)
        return 1;
    if (require_test(source->find_next("missing", 0) == 0,
            "missing") == 0)
        return 1;
    if (require_test(
            same_text(source->note->c_str(), "Not found"),
            "not found") == 0)
        return 1;
    if (require_test(source->find_prev("alpha", 0), "prev wrap") == 0)
        return 1;
    breaks[0] = 2;
    breaks[1] = 0;
    view = source->render(1, breaks, 1);
    if (require_test(
            view->find("> ") >= 0 && view->find("* ") >= 0,
            "render") == 0)
        return 1;
    out = fopen("/tmp/dbg-source.bin", "w");
    if (out == nullptr)
        return 1;
    fwrite((const void *)"a\0b", (unsigned long)1, (unsigned long)3, out);
    fclose(out);
    if (require_test(
            source->load("/tmp/dbg-source.bin") == 0,
            "binary") == 0)
        return 1;
    if (require_test(source->kind == SOURCE_BINARY, "kind") == 0)
        return 1;
    unlink(path);
    unlink("/tmp/dbg-source.bin");
    print("source 1\n");
    return 0;
}
